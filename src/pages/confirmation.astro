---
import Base from "../layouts/Base.astro";
---

<Base title="Thank you">
  <div class="form">
    <div class="success">
      <p>Success 💅</p>
      <h1>Thank you for your submission</h1>
    </div>
    <h2 class="next">What happens next</h2>
    <p>
      We'll contact you in the next day or two to confirm your image going on the website or to ask you some follow up
      questions.
    </p>
    <p class="home"><a href="/">Return to homepage</a></p>
  </div>
</Base>

<style>
  .next {
    font-size: 1.875rem;
    font-weight: 400;
    padding-top: 2rem;
  }
  p {
    font-size: 1.25rem;
  }
  .home {
    padding-top: 1rem;
  }
</style>
