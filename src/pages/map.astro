---
import Base from "../layouts/Base.astro";
import CouncilMap from "../components/CouncilMap.astro";
import Footer from "../components/Footer.astro";
import { load, collectors } from "../lib/govbins";
import { cataloguedBy } from "../lib/catalogued";

const { councils } = await load();
const today = collectors(councils);
const count = { harry: 0, others: 0, none: 0 };
for (const c of today) count[cataloguedBy(c)]++;
const done = count.harry + count.others;
---

<Base title="Map" description={`${count.none} UK councils' bins still to find`}>
  <div class="page">
    <h1>Map</h1>
    <p>
      {count.none} councils still to find. {done} of {today.length} catalogued.{" "}
      <a href="/submit-photos">Submit photos</a>
    </p>
    <ul class="key light">
      <li><span class="swatch by-none"></span>Not catalogued yet ({count.none})</li>
      <li><span class="swatch by-harry"></span>By Harry ({count.harry})</li>
      <li><span class="swatch by-others"></span>By others ({count.others})</li>
    </ul>
    <p class="hint light">Scroll or pinch to zoom, drag to move. Pick a council to see its bin.</p>
    <CouncilMap councils={today} />
    <p class="small light">
      Boundaries from <a href="https://geoportal.statistics.gov.uk/">ONS</a>. Contains OS data © Crown copyright and
      database right.
    </p>
    <Footer />
  </div>
</Base>

<style>
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 1.25rem;
    margin: 1rem 0;
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch {
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--ink);
  }
  .swatch.by-harry {
    background:
      radial-gradient(circle, var(--by-harry-mark) 1.4px, transparent 1.8px) 0 0 / 6px 6px,
      var(--by-harry);
  }
  .swatch.by-others {
    background:
      repeating-linear-gradient(-45deg, var(--by-others-mark) 0 2px, transparent 2px 7px),
      var(--by-others);
  }
  .swatch.by-none {
    background: var(--by-none);
  }
  .hint {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }
  .small {
    font-size: 1rem;
    margin-top: 0.75rem;
  }
</style>
