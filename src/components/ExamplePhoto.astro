---
// The example photo on the submit page, with guide lines that draw on
// one after another: rim level with the phone, space either side,
// space above the lid. Without motion, the lines are just there.
---

<figure class="example" data-example>
  <svg viewBox="0 0 1400 1048" role="img" aria-labelledby="example-title example-desc">
    <title id="example-title">Example photo</title>
    <desc id="example-desc">
      A green wheelie bin photographed straight on, in landscape, from the height of its rim, with space above the lid and on either side.
    </desc>
    <image href="/images/Walford.png" width="1400" height="1048" />

    <defs>
      <clipPath id="rim-reveal"><rect class="reveal" x="0" y="280" width="1400" height="50" /></clipPath>
    </defs>
    <g class="step s1">
      <line class="rim" x1="0" y1="305" x2="1400" y2="305" clip-path="url(#rim-reveal)" />
      <g class="label" transform="translate(1376 330)">
        <rect x="-450" y="0" width="450" height="58" rx="8" />
        <text x="-225" y="40">Phone level with the rim</text>
      </g>
    </g>

    <g class="step s2">
      <line class="draw" x1="8" y1="640" x2="222" y2="640" pathLength="1" />
      <line class="draw" x1="1392" y1="640" x2="1178" y2="640" pathLength="1" />
      <line class="tick" x1="8" y1="616" x2="8" y2="664" />
      <line class="tick" x1="1392" y1="616" x2="1392" y2="664" />
      <g class="label" transform="translate(24 668)">
        <rect x="0" y="0" width="128" height="58" rx="8" />
        <text x="64" y="40">Space</text>
      </g>
      <g class="label" transform="translate(1376 668)">
        <rect x="-128" y="0" width="128" height="58" rx="8" />
        <text x="-64" y="40">Space</text>
      </g>
    </g>

    <g class="step s3">
      <line class="draw" x1="1150" y1="8" x2="1150" y2="132" pathLength="1" />
      <line class="tick" x1="1126" y1="8" x2="1174" y2="8" />
      <g class="label" transform="translate(24 24)">
        <rect x="0" y="0" width="380" height="58" rx="8" />
        <text x="190" y="40">Space above the lid</text>
      </g>
    </g>

    <g class="step s4">
      <g class="label" transform="translate(700 960)">
        <rect x="-235" y="0" width="470" height="58" rx="8" />
        <text x="0" y="40">Straight on, landscape</text>
      </g>
    </g>
  </svg>
</figure>

<script>
  // loops like a GIF; people who prefer reduced motion get the finished guide, still
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const fig of document.querySelectorAll<HTMLElement>("[data-example]")) fig.classList.add("loop");
  }
</script>

<style>
  .example {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .draw,
  .tick,
  .rim {
    stroke: var(--pink);
    stroke-width: 8;
    stroke-linecap: round;
    fill: none;
  }
  .rim {
    stroke-dasharray: 28 16;
    stroke-linecap: butt;
  }
  .label rect {
    fill: rgba(31, 41, 55, 0.88);
  }
  .s1 .label rect {
    fill: var(--pink);
  }
  .label text {
    fill: #fff;
    font: 500 32px Rubik, system-ui, sans-serif;
    text-anchor: middle;
  }

  /* One 8-second cycle, repeated: each guide draws on in turn, everything
     holds, then fades out and starts again. */
  .loop .step,
  .loop .label,
  .loop .draw,
  .loop .reveal {
    animation-duration: 8s;
    animation-iteration-count: infinite;
    animation-timing-function: linear;
  }
  .loop .draw {
    stroke-dasharray: 1;
  }
  .loop .reveal { animation-name: reveal; transform-box: fill-box; transform-origin: left; }
  .loop .s1 { animation-name: step1; }
  .loop .s1 .label { animation-name: label1; }
  .loop .s2 { animation-name: step2; }
  .loop .s2 .draw { animation-name: draw2; }
  .loop .s2 .label { animation-name: label2; }
  .loop .s3 { animation-name: step3; }
  .loop .s3 .draw { animation-name: draw3; }
  .loop .s3 .label { animation-name: label3; }
  .loop .s4 { animation-name: step4; }

  /* rim line: 0.3s to 1.1s */
  @keyframes reveal { 0%, 4% { transform: scaleX(0); } 14%, 100% { transform: scaleX(1); } }
  @keyframes step1 { 0%, 3% { opacity: 0; } 4%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }
  @keyframes label1 { 0%, 13% { opacity: 0; } 17%, 100% { opacity: 1; } }
  /* space either side: 1.4s to 2.2s */
  @keyframes step2 { 0%, 17% { opacity: 0; } 18%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }
  @keyframes draw2 { 0%, 18% { stroke-dashoffset: 1; } 28%, 100% { stroke-dashoffset: 0; } }
  @keyframes label2 { 0%, 27% { opacity: 0; } 31%, 100% { opacity: 1; } }
  /* space above the lid: 2.6s to 3.4s */
  @keyframes step3 { 0%, 32% { opacity: 0; } 33%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }
  @keyframes draw3 { 0%, 33% { stroke-dashoffset: 1; } 43%, 100% { stroke-dashoffset: 0; } }
  @keyframes label3 { 0%, 42% { opacity: 0; } 46%, 100% { opacity: 1; } }
  /* straight on, landscape: 3.8s */
  @keyframes step4 { 0%, 47% { opacity: 0; } 52%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }
</style>
