---
import Base from "../layouts/Base.astro";
import CouncilMap from "../components/CouncilMap.astro";
import Footer from "../components/Footer.astro";
import { load, collectors } from "../lib/govbins";

const { councils } = await load();
const today = collectors(councils);
const done = today.filter((c) => c.bin);
const families = [
  ["purple", "Purple"],
  ["blue", "Blue"],
  ["green", "Green"],
  ["yellow-orange", "Yellow and orange"],
  ["red-burgundy", "Red and burgundy"],
  ["brown", "Brown"],
  ["grayscale", "Black and grey"],
  ["none", "Not catalogued yet"],
];
---

<Base title="Map">
  <div class="page">
    <h2>Map</h2>
    <p>{done.length} of {today.length} councils catalogued</p>
    <ul class="legend light">
      {
        families.map(([id, label]) => (
          <li>
            <span style={`background: var(--bin-${id})`} />
            {label}
          </li>
        ))
      }
    </ul>
    <div class="map">
      <CouncilMap councils={today} />
    </div>
    <Footer />
  </div>
</Base>
